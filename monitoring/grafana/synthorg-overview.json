          "title": "Escalation outcomes / sec",
          "description": "synthorg_escalation_outcomes_total partitioned by outcome (resolved / escalated_to_human / auto_resolved / notify_failed / sweeper_failed). Disjoint from the approval-decisions counter; emitted from the conflict-resolution + escalation modules.",
          "targets": [
            {
              "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
              "expr": "sum by (outcome) (rate(synthorg_escalation_outcomes_total[5m]))",
              "legendFormat": "{{outcome}}",
              "refId": "A"
