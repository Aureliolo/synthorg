          "type": "stat",
          "id": 812,
          "title": "MCP handler success rate",
          "description": "rate(synthorg_mcp_handler_outcomes_total{outcome=\"success\"}[5m]) / rate(synthorg_mcp_handler_outcomes_total[5m]). Drops below ~0.99 indicate handler regressions.",
          "targets": [
            {
              "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
              "expr": "sum(rate(synthorg_mcp_handler_outcomes_total{outcome=\"success\"}[5m])) / clamp_min(sum(rate(synthorg_mcp_handler_outcomes_total[5m])), 1)",
