# Test-mode env (loaded by vitest, mode=test). Committed and authoritative so
# tests are deterministic regardless of a developer's local .env. The dev auth
# bypass must be OFF here: with it on, modules loaded during test setup (e.g.
# api/client) bind it before per-file vi.mock() applies, which breaks the 401
# interceptor tests. Individual tests opt the bypass on/off via vi.mock().
VITE_DEV_AUTH_BYPASS=false
