---
const heroFeatures = [
  {
    icon: "\u2699",
    title: "Orchestration Engine",
    headline: "Six routing strategies. Three execution loops. One engine.",
    description:
      "Agents bid for tasks via auction, get assigned by role, or get load-balanced. The engine decomposes work into DAGs, resolves conflicts, and recovers from crashes automatically.",
    differentiator:
      "Sequential, parallel, Kanban, and Agile sprint workflows built in.",
    href: "/docs/design/engine/",
    color: "violet",
  },
  {
    icon: "\uD83D\uDD12",
    title: "Governance & Security",
    headline: "Every action classified, audited, and gated.",
    description:
      "Hybrid SecOps: rule engine fast-path for ~95% of actions in sub-millisecond, plus LLM evaluator for uncertain cases. Five autonomy tiers. 25+ classified action types. Budget enforcement at every layer.",
    differentiator:
      "Progressive trust: privileges never auto-granted, auto-downgrade on violations.",
    href: "/docs/security/",
    color: "teal",
  },
  {
    icon: "\uD83E\uDDE0",
    title: "Agent Identity",
    headline: "Agents with personalities, careers, and performance reviews.",
    description:
      "Big Five personality dimensions drive team compatibility. Eight seniority levels from Intern to C-Suite. Three-tier quality scoring. Hiring, promotions, and firing with full memory archival.",
    differentiator:
      "Not interchangeable workers; agents have identity and growth.",
    href: "/docs/design/agents/",
    color: "violet",
  },
  {
    icon: "\uD83D\uDDC3",
    title: "Memory & Knowledge",
    headline: "Five memory types. Knowledge that outlasts any agent.",
    description:
      "Working, episodic, semantic, procedural, and social memory. Hybrid prompt and retrieval injection. Memories survive offboarding and transfer to successors automatically.",
    differentiator:
      "Organizational knowledge persists across the entire agent lifecycle.",
    href: "/docs/design/memory/",
    color: "teal",
  },
];

---

<!-- Hero feature cards -->
<div class="grid md:grid-cols-2 gap-6">
  {heroFeatures.map((f) => {
    const borderColor = f.color === "violet"
      ? "border-violet-500/20 hover:border-violet-500/40"
      : "border-teal-500/20 hover:border-teal-500/40";
    const iconBg = f.color === "violet" ? "bg-violet-600/20" : "bg-teal-600/20";
    const iconColor = f.color === "violet" ? "text-violet-400" : "text-teal-400";
    const diffColor = f.color === "violet" ? "text-violet-400/80" : "text-teal-400/80";
    const ringColor = f.color === "violet" ? "focus-visible:ring-violet-400" : "focus-visible:ring-teal-400";
    return (
      <a
        href={f.href}
        class={`block bg-[#0F1219] rounded-xl p-8 border ${borderColor} transition-colors no-underline text-white group focus-visible:outline-none focus-visible:ring-2 ${ringColor} focus-visible:ring-offset-2 focus-visible:ring-offset-[#0F1219]`}
      >
        <div class={`w-12 h-12 rounded-lg ${iconBg} flex items-center justify-center ${iconColor} mb-4 text-xl`}>
          {f.icon}
        </div>
        <h3 class="text-xl font-semibold mb-1">{f.title}</h3>
        <p class={`text-sm ${iconColor} font-medium mb-3`}>{f.headline}</p>
        <p class="text-gray-400 text-sm mb-3">{f.description}</p>
        <p class={`text-xs ${diffColor} italic`}>{f.differentiator}</p>
      </a>
    );
  })}
</div>
