# =============================================================================
# SynthOrg -- Environment Variables
# =============================================================================
# Copy this file to .env and fill in values (from repo root):
#   cp docker/.env.example docker/.env
# =============================================================================

# --- Authentication ----------------------------------------------------------
# JWT signing secret (required). Generated by 'synthorg init'.
# Must be >= 32 characters.
# Generate manually: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SYNTHORG_JWT_SECRET=

# Fernet encryption key for sensitive settings at rest (required).
# Generated by 'synthorg init'. Must be a valid Fernet key (32 bytes, URL-safe base64).
# Generate manually: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SYNTHORG_SETTINGS_KEY=

# HMAC signing key for opaque pagination cursor tokens (required).
# Generated by 'synthorg init'. Must be at least 16 bytes; the backend
# refuses to start with an ephemeral per-process key because rotating
# it across restarts silently invalidates every outstanding cursor
# token. The boot guard is the same in dev, pre-release, and prod --
# every channel needs a stable value.
# Generate manually: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SYNTHORG_PAGINATION_CURSOR_SECRET=

# --- Persistence (Postgres) --------------------------------------------------
# Postgres superuser password for the compose-managed database (required --
# compose fails to start without it). Generated by 'synthorg init' (32 bytes).
# Generate manually: python -c "import secrets; print(secrets.token_urlsafe(32))"
# POSTGRES_PASSWORD=

# First-run: POST /api/v1/auth/setup to create admin account

# --- Application -------------------------------------------------------------
# SQLite database path (inside container: /data/synthorg.db). Only used by a
# SQLite install; the bundled compose.yml sets SYNTHORG_DATABASE_URL for the
# managed Postgres service, which takes precedence and leaves this ignored.
SYNTHORG_DB_PATH=/data/synthorg.db

# Agent memory storage directory (inside container: /data/memory)
SYNTHORG_MEMORY_DIR=/data/memory

# Persistence backend. The bundled compose.yml runs the backend against the
# managed Postgres service and pins this via the backend service's inline
# environment, which overrides this file; this value only takes effect for
# setups that read .env directly.
SYNTHORG_PERSISTENCE_BACKEND=postgres

# Memory backend: sqlvector (durable, semantic), composite (per-namespace
# routing) or inmemory (ephemeral, discouraged: loses every memory on restart)
SYNTHORG_MEMORY_BACKEND=sqlvector

# Log file directory (inside container: /data/logs, persisted via volume)
SYNTHORG_LOG_DIR=/data/logs

# Console log level override (valid: debug, info, warning, error, critical)
# SYNTHORG_LOG_LEVEL=info

# --- Container Networking ----------------------------------------------------
# Host port for the backend API (default 3001 to avoid collision with
# vLLM's default port 8000).
BACKEND_PORT=3001

# Host port for the web dashboard
WEB_PORT=3000

# --- Docker Sandbox ----------------------------------------------------------
# Docker socket for agent code execution sandbox (optional)
# DOCKER_HOST=unix:///var/run/docker.sock

# Container images for the sandbox, its sidecar, and fine-tuning. Blank
# resolves to the pinned default the backend image ships.
# SYNTHORG_SANDBOX_IMAGE=
# SYNTHORG_SIDECAR_IMAGE=
# SYNTHORG_FINE_TUNE_IMAGE=

# --- Fixed at process start ---------------------------------------------------
# The settings below are compose-set: the backend reads each one when it
# starts and nothing inside the running system can change it, so the
# dashboard shows them read-only and rejects a write. Everything else is
# live and belongs in the dashboard, not here. The bind address is pinned
# to the container's own interface and is not an override.

# Route prefix every API path is mounted under. The dashboard is built
# against it, so changing it means rebuilding the web image too.
# SYNTHORG_API_API_PREFIX=/api/v1

# TLS material, read once when uvicorn binds.
# SYNTHORG_API_SSL_CERTFILE=
# SYNTHORG_API_SSL_KEYFILE=
# SYNTHORG_API_SSL_CA_CERTS=

# Reverse proxies whose forwarded-for header the rate limiter may trust.
# Leaving this empty behind a proxy makes every caller share one bucket.
# SYNTHORG_API_TRUSTED_PROXIES=[]

# Browser origins allowed to call the API, and the paths exempt from
# authentication and from rate limiting. All three are applied when the
# middleware stack is mounted.
# SYNTHORG_API_CORS_ALLOWED_ORIGINS=[]
# SYNTHORG_API_AUTH_EXCLUDE_PATHS=
# SYNTHORG_API_RATE_LIMIT_EXCLUDE_PATHS=

# Largest request body accepted, in bytes.
# SYNTHORG_API_REQUEST_MAX_BODY_SIZE_BYTES=10485760

# RFC 3161 timestamp authorities for the signed audit chain. Resolved
# before the settings backend exists, so the deployment is the only place
# they can be chosen.
# SYNTHORG_OBSERVABILITY_TSA_ENDPOINT_FREETSA=https://freetsa.org/tsr
# SYNTHORG_OBSERVABILITY_TSA_ENDPOINT_DIGICERT=https://timestamp.digicert.com
# SYNTHORG_OBSERVABILITY_TSA_ENDPOINT_SECTIGO=https://timestamp.sectigo.com

# Provider cassettes: recording or replaying is chosen for the whole run,
# because switching mid-process leaves a half-recorded transcript.
# SYNTHORG_PROVIDERS_CASSETTE_MODE=off
# SYNTHORG_PROVIDERS_CASSETTE_PATH=
