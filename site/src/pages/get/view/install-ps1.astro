---
import Base from "../../../layouts/Base.astro";
import fs from "node:fs";
import path from "node:path";

// Resolve from the Astro project root (process.cwd()). The build always runs
// with cwd=site/ (workflows pin working-directory: site). import.meta.url is
// NOT usable here: Astro bundles this frontmatter into dist/.prerender chunks,
// so at build time it points at the emitted chunk, not this source file.
const scriptPath = path.resolve("../cli/scripts/install.ps1");
let content: string;
try {
  content = fs.readFileSync(scriptPath, "utf-8");
} catch (err) {
  throw new Error(
    `install-ps1.astro: could not read the CLI install script at ${scriptPath} ` +
      `(cwd=${process.cwd()}). Ensure cli/scripts/install.ps1 exists and the build ` +
      `runs from the site/ directory. Original error: ${(err as Error).message}`,
  );
}
---

<Base
  title="SynthOrg CLI install script (Windows / PowerShell)"
  description="Review the SynthOrg Windows PowerShell install script (install.ps1) before piping it to your shell."
  noindex={true}
>
  <section class="pt-16 pb-10 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h1 class="text-2xl font-bold mb-1">install.ps1</h1>
          <p class="text-sm text-gray-400">Windows (PowerShell) install script</p>
        </div>
        <div class="flex gap-3">
          <a
            href="/get/install.ps1"
            download
            class="inline-flex items-center px-4 py-2 bg-violet-600 hover:bg-violet-500 rounded-lg text-sm font-semibold transition-colors"
          >
            Download
          </a>
          <a
            href="/get/"
            class="inline-flex items-center px-4 py-2 border border-white/20 hover:border-white/40 rounded-lg text-sm text-gray-300 transition-colors"
          >
            Back
          </a>
        </div>
      </div>
      <div class="bg-[#0d1117] rounded-xl border border-white/10 overflow-hidden">
        <div class="flex items-center px-4 py-2 bg-[#161b22] border-b border-white/10">
          <div class="flex items-center gap-1">
            <span class="text-xs text-gray-400 font-mono">install.ps1</span>
          </div>
          <div class="ml-auto flex items-center gap-2.5 text-gray-600 text-xs leading-none">
            <span>&#x2500;</span>
            <span>&#x25A1;</span>
            <span>&#x2715;</span>
          </div>
        </div>
        <pre class="p-4 text-sm font-mono text-gray-300 overflow-x-auto leading-relaxed"><code>{content}</code></pre>
      </div>
    </div>
  </section>
</Base>
