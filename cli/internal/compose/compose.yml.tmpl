# Generated by SynthOrg CLI {{.CLIVersion}}
# Do not edit manually -- run 'synthorg init' to regenerate.
{{- /*
Rationale belongs in template comments like this one, which never reach the
generated file. A plain `#` comment ships to an operator who is told not to
edit the file, so keep those to the few warnings that survive someone editing
it anyway.

No `# renovate:` marker belongs here. Renovate matches the literal busybox
`image:` line by regex (renovate.json customManagers), and the DHI pins are
written by the CLI from state.go's Default*Image{Tag,Digest}, so a marker in
this file would claim an update path that does not exist.
*/}}
services:
{{- if postgresEnabled}}
  postgres:
    image: {{.DHIRegistry}}/{{.PostgresImageName}}:{{.PostgresImageTag}}{{if .PostgresDigest}}@{{.PostgresDigest}}{{end}}
    ports:
      - "{{.PostgresPort}}:5432"
    volumes:
      - synthorg-pgdata:/var/lib/postgresql/data
    depends_on:
      data-init:
        condition: service_completed_successfully
    environment:
      PGDATA: /var/lib/postgresql/data
      POSTGRES_DB: synthorg
      POSTGRES_USER: synthorg
      POSTGRES_PASSWORD: {{yamlStr .PostgresPassword}}
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    read_only: true
    tmpfs:
      - /tmp:noexec,nosuid,nodev,size=64m
      - /run/postgresql:noexec,nosuid,nodev,size=8m
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 1G
          cpus: "1.0"
          pids: 128
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "synthorg", "-d", "synthorg"]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 30s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{{- end}}
{{- /*
data-init chowns the named volumes to each service's non-root UID. Fresh
Docker volumes are root-owned and DHI images cannot self-chown, so this
one-shot container sets ownership on first start.
*/}}

  data-init:
    image: busybox:1.38-musl@sha256:246a00b08ecde11a4769a2587ab2c683e525b9f94b02dd9f73a6869108066bb9
    volumes:
      - synthorg-data:/data
{{- if postgresEnabled}}
      - synthorg-pgdata:/pgdata
{{- end}}
{{- if distributedEnabled}}
      - synthorg-nats-data:/nats-data
{{- end}}
    command: ["sh", "-c", "set -e; mkdir -p /data/logs /data/memory /data/tunnel; chown -R 65532:65532 /data{{if postgresEnabled}}; chown -R 70:70 /pgdata; chmod 0700 /pgdata{{end}}{{if distributedEnabled}}; chown -R 65532:65532 /nats-data{{end}}"]
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
{{- /*
A single busybox process doing one chown walk: the limits cap blast radius
without throttling a first run over a large pre-existing volume.
*/}}
    deploy:
      resources:
        limits:
          memory: 128M
          cpus: "1.0"
          pids: 64

  backend:
    image: {{digestPin "backend" (printf "%s/%sbackend" .RegistryHost .ImageRepoPrefix) .ImageTag}}
    ports:
      - "{{.BackendPort}}:3001"
    volumes:
      - synthorg-data:/data
{{- if .Sandbox}}
      # WARNING: root-equivalent access to the host Docker daemon, needed
      # so the backend can spawn sandbox containers. The hardening below
      # does not contain socket-level privilege.
      - "{{.DockerSock}}:/var/run/docker.sock"
{{- end}}
    depends_on:
      data-init:
        condition: service_completed_successfully
{{- if postgresEnabled}}
      postgres:
        condition: service_healthy
{{- end}}
    environment:
{{- /*
SYNTHORG_HOST/SYNTHORG_PORT/UVICORN_HOST/UVICORN_PORT are baked into the
backend image ENV (docker/backend/Dockerfile); setting them here would only
duplicate the defaults. An operator overriding them still does so via
env_file / shell env, which docker-compose forwards into the container.
*/}}
{{- if postgresEnabled}}
      SYNTHORG_DATABASE_URL: {{yamlStr pgDSN}}
      # The local Postgres image runs without TLS on the internal docker
      # network. Production wants verify-full plus certificate material.
      SYNTHORG_POSTGRES_SSL_MODE: "disable"
{{- else}}
      SYNTHORG_DB_PATH: "/data/synthorg.db"
{{- end}}
      SYNTHORG_MEMORY_DIR: "/data/memory"
      SYNTHORG_PERSISTENCE_BACKEND: {{yamlStr .PersistenceBackend}}
      SYNTHORG_MEMORY_BACKEND: {{yamlStr .MemoryBackend}}
      SYNTHORG_BUS_BACKEND: {{yamlStr .BusBackend}}
{{- if distributedEnabled}}
      SYNTHORG_NATS_URL: {{yamlStr .NATSURL}}
{{- end}}
      SYNTHORG_LOG_DIR: "/data/logs"
      SYNTHORG_TUNNEL_STATE_DIR: "/data/tunnel"
      SYNTHORG_TELEMETRY_ENABLED: "{{if .TelemetryOptIn}}true{{else}}false{{end}}"
      SYNTHORG_LOG_LEVEL: {{yamlStr .LogLevel}}
      # Paired with `restart: unless-stopped` below: drop one and drop the
      # other, or the dashboard offers a restart nothing comes back from.
      SYNTHORG_API_RESTART_SUPERVISED: "true"
{{- if .Sandbox}}
      SYNTHORG_SANDBOX_IMAGE: {{yamlStr (sandboxImageRef .ImageTag)}}
      SYNTHORG_SIDECAR_IMAGE: {{yamlStr (sidecarImageRef .ImageTag)}}
{{- end}}
{{- if and .Sandbox .FineTuning}}
      SYNTHORG_FINE_TUNE_IMAGE: {{yamlStr (fineTuneImageRef .ImageTag)}}
{{- end}}
{{- if .JWTSecret}}
      SYNTHORG_JWT_SECRET: {{yamlStr .JWTSecret}}
{{- end}}
{{- if .SettingsKey}}
      SYNTHORG_SETTINGS_KEY: {{yamlStr .SettingsKey}}
{{- end}}
{{- if .CursorSecret}}
{{- /*
HMAC signing key for opaque pagination cursor tokens. The backend refuses to
start without one (synthorg.api.app create_app), in dev and pre-release as
much as in prod -- there is no env-marker exception.
*/}}
      # Rotating this invalidates every outstanding pagination cursor.
      SYNTHORG_PAGINATION_CURSOR_SECRET: {{yamlStr .CursorSecret}}
{{- end}}
{{- if and .EncryptSecrets .MasterKey}}
{{- /*
Fernet master key for the encrypted secret backend; the backend auto-selects
encrypted_sqlite or encrypted_postgres to match the persistence backend.
Generated by `synthorg init` and preserved across re-init. With
EncryptSecrets disabled the var is omitted and the backend falls back to
env_var, i.e. no at-rest encryption.
*/}}
      # Permanent for the life of the install: rotation is not supported,
      # and a changed key makes every stored connection secret unreadable.
      SYNTHORG_MASTER_KEY: {{yamlStr .MasterKey}}
{{- end}}
{{- /* The image sets USER 65532 (docker/backend/Dockerfile). */}}
{{- if and .Sandbox (ge .DockerSockGID 0)}}
    # Host-specific: the GID owning {{.DockerSock}}, so the non-root backend
    # user can use the socket without relaxing host permissions. Re-run
    # 'synthorg init' when moving to another host.
    group_add:
      - "{{.DockerSockGID}}"
{{- end}}
{{- /* CIS Docker Benchmark v1.6.0 hardening (5.3, 5.12, 5.25, 5.28). */}}
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp:noexec,nosuid,nodev,size=64m
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 4G
          cpus: "2.0"
          pids: 256
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{{- /*
No backend healthcheck here. docker/backend/Dockerfile is the only definition
and a compose-level block would replace it wholesale, start period included.
*/}}

  web:
    image: {{digestPin "web" (printf "%s/%sweb" .RegistryHost .ImageRepoPrefix) .ImageTag}}
    ports:
      - "{{.WebPort}}:8080"
    depends_on:
      backend:
        condition: service_healthy
{{- /* The apko image sets run-as "65532" (docker/web/apko.yaml). */}}
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      # uid/gid are load-bearing: a tmpfs mounts root-owned by default,
      # which Caddy (running as 65532) cannot write, so it would fall
      # back to read-only mode.
      - /tmp:noexec,nosuid,nodev,size=16m,uid=65532,gid=65532
      - /config/caddy:noexec,nosuid,nodev,size=8m,uid=65532,gid=65532
      - /data/caddy:noexec,nosuid,nodev,size=16m,uid=65532,gid=65532
{{- /*
Caddy serves a plain "ok" 200 at /healthz and the apko image carries wget
solely for this probe. 127.0.0.1 keeps DNS out of the probe hot path.
*/}}
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:8080/healthz"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 10s
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: "0.5"
          pids: 64
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{{- if distributedEnabled}}
{{- /*
DHI NATS is distroless and runs as nonroot (65532), with no in-container
healthcheck because DHI ships no shell or wget by design. Liveness surfaces at
the application layer instead: NatsBus.health_check does a live PING/PONG and
the backend's /api/v1/readyz reports it. Do not add a busybox health sidecar
-- nothing in compose ever consumed its service_healthy state.

Config comes from a bind-mounted nats.conf written next to compose.yml by the
CLI: NATS 2.12 has no --max_payload CLI flag, so anything diverging from the
defaults must come from a file.
*/}}

  nats:
    image: {{.DHIRegistry}}/nats:{{.NATSImageTag}}{{if .NATSDigest}}@{{.NATSDigest}}{{end}}
    command: ["-c", "/etc/nats/nats.conf"]
    ports:
      - "{{.NATSClientPort}}:4222"
      # Uncomment to expose NATS monitoring (/varz, /healthz, server stats)
      # to the host. It is UNAUTHENTICATED; /api/v1/readyz is the supported
      # health path.
      # - "8222:8222"
    volumes:
      - synthorg-nats-data:/data
      - ./nats.conf:/etc/nats/nats.conf:ro
    depends_on:
      data-init:
        condition: service_completed_successfully
    user: "65532:65532"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp:noexec,nosuid,nodev,size=16m
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: "0.5"
          pids: 64
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{{- end}}

networks:
  default:
    name: synthorg-net

volumes:
  synthorg-data:
{{- if postgresEnabled}}
  synthorg-pgdata:
{{- end}}
{{- if distributedEnabled}}
  synthorg-nats-data:
{{- end}}
