        {
          "type": "stat",
          "id": 822,
          "title": "Audit chain integrity (last hour, broken)",
          "description": "increase(synthorg_audit_chain_verifications_total{outcome=\"broken\"}[1h]). Any non-zero value is an alertable incident: hash-chain tampering, signature corruption, or storage drift. The 'valid' outcome is intentionally excluded so healthy verification traffic does not trip the threshold.",
          "targets": [
            {
              "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
              "expr": "sum(increase(synthorg_audit_chain_verifications_total{outcome=\"broken\"}[1h]))",
              "legendFormat": "broken",
              "refId": "A"
            }
          ],
          "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}},
          "gridPos": {"h": 8, "w": 8, "x": 8, "y": 67}
        },
        {
          "type": "timeseries",
          "id": 823,
          "title": "Budget query p95 latency by query type",
          "description": "histogram_quantile(0.95, rate(synthorg_budget_query_duration_seconds_bucket[5m])) split by query_type (total_cost / agent_cost / project_cost / ...). Budget reads are SQLite-bound; p95 over 100ms is a regression.",
          "targets": [
            {
              "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
              "expr": "histogram_quantile(0.95, sum by (le, query_type) (rate(synthorg_budget_query_duration_seconds_bucket[5m])))",
              "legendFormat": "{{query_type}}",
              "refId": "A"
            }
          ],
          "fieldConfig": {"defaults": {"unit": "s"}},
          "gridPos": {"h": 8, "w": 8, "x": 16, "y": 67}
        }
      ]
    }
