          "description": "histogram_quantile(0.95, rate(synthorg_mcp_handler_duration_seconds_bucket[5m])) split by tool. The buckets cap at 10s; an MCP handler in the top bucket signals a service-boundary regression.",
          "targets": [
            {
              "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
              "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(synthorg_mcp_handler_duration_seconds_bucket[5m])))",
              "legendFormat": "{{tool}}",
              "refId": "A"
            }
          ],
