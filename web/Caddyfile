# SynthOrg web dashboard -- served by Caddy from a pure-apko Wolfi image.
# Installed at /etc/synthorg/Caddyfile by docker/web/melange.yaml.
#
# Replicates every behavior of the previous web/nginx.conf:
#   - :8080 unprivileged listen
#   - precompressed br gzip (Caddy's file_server directive replaces gzip_static)
#   - per-request CSP nonce via the templates directive +
#     {{placeholder "http.request.uuid"}} (replaces nginx sub_filter + $request_id)
#   - SPA fallback to /index.html (replaces try_files)
#   - /assets/* immutable year-long cache, no CSP
#   - /docs/* static CSP, 1h revalidation
#   - /api/v1/ws WebSocket proxy to backend:3001 (3600s read timeout)
#   - /api/* REST proxy to backend:3001
#   - shared security headers (X-Content-Type-Options, X-Frame-Options,
#     Referrer-Policy, Permissions-Policy, HSTS, templated CSP)
{
	auto_https off
	admin off
	servers :8080 {
		trusted_proxies static private_ranges
	}
	log {
		output stderr
		format json
	}
}

(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), serial=(), bluetooth=(), screen-wake-lock=(), display-capture=()"
		# HSTS is a no-op on this plain-HTTP :8080 listener (browsers ignore
		# Strict-Transport-Security over HTTP). It is emitted so the policy is
		# already correct once a TLS-terminating proxy fronts the container.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
		defer
	}
}

(spa_csp) {
	# Per-request CSP.  {http.request.uuid} is stable within a single
	# request, so the nonce value emitted into this header matches the
	# value the templates directive substitutes into index.html on the
	# same response.  Dual style-src directives mirror the old nginx
	# setup: style-src-elem locks <style> tags in modern browsers to the
	# per-request nonce; style-src 'unsafe-inline' is the fallback for
	# browsers without Level 3 support; style-src-attr 'unsafe-inline'
	# is required by Floating UI (Base UI) for positioning.
	#
	# ACCEPTED RELAXATION: 'unsafe-inline' in style-src stays active even
	# when a nonce is present (unlike script-src, CSP-L3 browsers do not
	# ignore it). It is retained deliberately as the CSP-Level-2 fallback;
	# nonce-aware browsers still get style-src-elem nonce protection for
	# <style> elements. Removing it would block Base UI positioning styles
	# on Level-2-only browsers, so the residual inline-style risk is a
	# known, accepted trade-off.
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'nonce-{http.request.uuid}' 'unsafe-inline'; style-src-elem 'self' 'nonce-{http.request.uuid}'; style-src-attr 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" {
		defer
	}
}

(api_security_headers) {
	# Non-CSP security headers for proxied /api/* and /api/v1/ws routes.
	# Backend emits its own Content-Security-Policy and we pass it
	# through verbatim via reverse_proxy; no CSP is layered here so the
	# backend's JSON policy is not clobbered.  These other hardening
	# headers still apply to Caddy-generated error responses (502/504)
	# when the backend is unreachable.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), serial=(), bluetooth=(), screen-wake-lock=(), display-capture=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
		defer
	}
}

:8080 {
	root * /usr/share/caddy/html

	# --- Container health probe: plain-text 200 for Docker HEALTHCHECK.
	# Served before any static-asset handling so the probe stays cheap
	# and independent of SPA bundle state. No security headers -- the
	# response body is a literal "ok" with no user content. log_skip
	# keeps the access log quiet under a 10s probe interval.
	handle /healthz {
		log_skip
		respond "ok" 200
	}

	# --- WebSocket proxy: must precede /api/* so it matches first ---
	@ws path /api/v1/ws
	handle @ws {
		import api_security_headers
		log_skip
		reverse_proxy backend:3001 {
			header_up Host {host}
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}

			transport http {
				dial_timeout 5s
				write_timeout 30s
				read_timeout 3600s
			}
		}
	}

	# --- REST API proxy ---
	handle /api/* {
		import api_security_headers
		reverse_proxy backend:3001 {
			header_up Host {host}
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}

			transport http {
				dial_timeout 5s
				write_timeout 30s
				read_timeout 30s
				keepalive 30s
			}
		}
	}

	# --- Immutable hashed assets (Vite content-hashed filenames) ---
	# Year-long immutable cache.  Deliberately no CSP -- the policy only
	# governs the document that loads these assets, so embedding a
	# per-request CSP nonce in an asset response would pin a stale nonce
	# into every cached copy.
	handle /assets/* {
		header {
			X-Content-Type-Options "nosniff"
			# Document-level headers still apply to a directly-navigated
			# asset response and cost nothing on sub-resource loads; mirror
			# the (security_headers) snippet so a cached/304 asset is never
			# served without them. CSP stays
			# omitted (a per-request nonce cannot be cached, see above).
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), serial=(), bluetooth=(), screen-wake-lock=(), display-capture=()"
			Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
			Cache-Control "public, max-age=31536000, immutable"
			-Server
		}
		file_server {
			precompressed br gzip
		}
	}

	# --- Bare /docs redirect to /docs/ for consistent trailing slash ---
	handle /docs {
		redir /docs/ permanent
	}

	# --- Legacy doc URL redirects (must precede the generic /docs/* handler) ---
	# Keep old inbound links working when docs were moved or renamed.
	# Add an entry here when relocating a page; remove once the link
	# source is updated. Each matcher is two exact paths (with and
	# without trailing slash); it does NOT match deeper sub-paths, so
	# a redirect for ``/docs/decisions`` does not capture new pages
	# under ``docs/decisions/``.
	#
	# Rename rationale:
	#   * ``getting-started`` -> ``getting_started`` aligns with the
	#     snake_case filename in ``docs/``.
	#   * ``decisions`` -> ``architecture/decisions`` and
	#     ``comparison`` -> ``reference/comparison`` reflect the docs
	#     IA grouping by topic (architecture, reference, guides).
	@legacy_getting_started path /docs/getting-started /docs/getting-started/
	redir @legacy_getting_started /docs/getting_started/ permanent
	@legacy_decisions path /docs/decisions /docs/decisions/
	redir @legacy_decisions /docs/architecture/decisions/ permanent
	@legacy_comparison path /docs/comparison /docs/comparison/
	redir @legacy_comparison /docs/reference/comparison/ permanent

	# --- Static MkDocs documentation (no nonce) ---
	handle /docs/* {
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), serial=(), bluetooth=(), screen-wake-lock=(), display-capture=()"
			Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
			Cache-Control "public, max-age=3600"
			-Server
			defer
		}
		file_server {
			precompressed br gzip
		}
	}

	# --- SPA / index.html: nonce substitution + no-cache + SPA fallback ---
	# No `precompressed` on this handler: the templates directive must see
	# the source index.html body to substitute the CSP nonce placeholder,
	# and precompressed would serve the .gz verbatim and skip templating.
	handle {
		import security_headers
		import spa_csp
		header Cache-Control "no-cache" {
			defer
		}
		try_files {path} /index.html
		templates
		file_server
	}
}
