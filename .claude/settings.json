{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/check_no_repush_after_failure.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_push_rebased.sh",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": "bash scripts/check_push_throttle.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_ci_before_push.sh",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": "bash scripts/check_no_throttle_override_creation.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_no_baseline_update.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_bash_no_write.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_git_c_cwd.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_no_git_no_verify.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_no_cmd_pager_pipe.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "python3 scripts/check_no_bulk_edit.py",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_no_pr_create.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_no_cd_prefix.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_no_local_coverage.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_enforce_parallel_tests.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_no_unapproved_e2e_tests.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/check_mock_spec_ratchet.py",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/check_no_edit_migration.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_no_edit_baseline.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_no_em_dashes_hook.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_pre_pr_review_triage_gate.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_no_throttle_override_creation.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash scripts/check_no_audit_scratch_scripts.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/check_web_design_system.py",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "python scripts/check_backend_regional_defaults.py",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/record_push_throttle.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
