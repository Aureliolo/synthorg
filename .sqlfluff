# sqlfluff configuration: SQL lint for migration revisions and the
# canonical declared schema.
#
# Two dialects: SQLite under persistence/sqlite/ and Postgres under
# persistence/postgres/. The default dialect is SQLite; the postgres
# path is selected per-invocation via --dialect postgres.
#
# The default ruleset is active save one exclusion, PG01
# (postgres.excessive_locks), documented at exclude_rules below. The 38
# historical revision files are frozen (check_no_edit_migration.sh plus
# yoyo's content-hash check), so their cosmetic violations cannot be
# remediated; they are exempted in .sqlfluffignore. New revisions are
# deliberately NOT exempted, so they inherit the full ruleset. The
# canonical schema.sql files ARE linted; their CREATE TRIGGER / CREATE
# FUNCTION bodies carry scoped `-- noqa: disable=all` so reformatting
# cannot diverge them from the frozen-revision DDL that
# check_schema_drift_revisions.py compares case-sensitively.

[sqlfluff]
dialect = sqlite
templater = raw
# PG01 (postgres.excessive_locks) demands CREATE INDEX CONCURRENTLY, but
# every index here is built in the same migration that creates its table,
# so the table is empty and the build locks nothing. CONCURRENTLY cannot
# run inside a transaction, so adopting it would only make these
# migrations non-atomic for no availability gain. Re-enable when a
# migration indexes an already-populated table under live traffic.
exclude_rules = PG01
# schema.sql is ~80 KB, over sqlfluff's default 20000-byte skip limit;
# 0 disables the skip so the canonical schema is linted, not silently
# passed.
large_file_skip_byte_limit = 0
max_line_length = 200
indent_unit = space
tab_space_size = 4

[sqlfluff:indentation]
indented_joins = false
indented_using_on = true
template_blocks_indent = false

[sqlfluff:rules]
allow_scalar = true
single_table_references = consistent
unquoted_identifiers_policy = aliases

[sqlfluff:rules:references.keywords]
# Column names that are intentionally SQL keywords, chosen for domain
# clarity (the engine quotes them on access, so they are safe). The
# Postgres dialect reserves far more of these than SQLite. RF04 stays
# active for every OTHER keyword, unlike the previous blanket
# exclude_rules = RF04.
ignore_words = constraints, content, cost, dependencies, fields, key, model, name, path, provider, role, rowid, sequence, snapshot, stage, text, timestamp, type, value, version

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = consistent

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper
