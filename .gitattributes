# Normalize all text files to LF in the repo; checkout line endings depend on Git config.
# Silences CRLF conversion warnings on Windows.
* text=auto

# Go tooling (gofmt, golangci-lint) requires LF line endings.
# Without this, core.autocrlf=true on Windows converts to CRLF on checkout,
# causing spurious "not properly formatted" errors -- especially in worktrees.
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Go templates and golden test data -- template output is LF;
# byte-for-byte golden comparisons break if checked out as CRLF.
*.tmpl text eol=lf
cli/testdata/**/*.yml text eol=lf

# Schema files + yoyo revisions -- yoyo's content-hash check is
# whitespace-sensitive, so mixed line endings between Windows and
# Linux would trip the apply-time hash check on shared revisions.
src/synthorg/persistence/sqlite/revisions/*.sql text eol=lf
src/synthorg/persistence/sqlite/schema.sql text eol=lf
src/synthorg/persistence/postgres/revisions/*.sql text eol=lf
src/synthorg/persistence/postgres/schema.sql text eol=lf

# Vulnerability triage -- Trivy reads the rendered documents and cosign signs
# the OpenVEX one as an attestation predicate, so what is on disk is the
# artefact, byte for byte. `text=auto` with the default core.eol=native hands
# a Windows checkout CRLF, which would sign different bytes than were
# reviewed. scripts/check_vex_triage_sync.py compares bytes and reports a
# CRLF checkout by name, so this pin is enforced rather than assumed.
.github/vex/* text eol=lf
.github/.trivyignore.yaml text eol=lf

# apko manifests and their lockfiles -- `apko lock` records a sha256 over the
# manifest's raw bytes in the lock's `config.checksum`, so a CRLF checkout makes
# a locally regenerated lock disagree with the byte-identical one CI produces.
# The two then differ on the one field that says which manifest the lock belongs
# to, which is the field a consumer would check before trusting the pin.
# scripts/check_apko_lock_applied.py compares those bytes, so this is enforced
# rather than assumed.
docker/*/apko.yaml text eol=lf
docker/*/apko.lock.json text eol=lf

# Shell scripts must use LF (bash can't parse CRLF).
*.sh text eol=lf

# Committed git hook wrappers are extensionless (git only invokes a
# hook file named exactly pre-commit / pre-push / commit-msg), so the
# *.sh rule above misses them. They run via `#!/usr/bin/env bash`; a
# CRLF checkout makes the kernel look for `bash\r` and every hook
# fails silently. Pin to LF regardless of platform / core.autocrlf.
scripts/git-hooks/* text eol=lf

# ZAP DAST rules file is parsed on Linux runners; CRLF was observed
# leaking in from Windows-side edits, leaving the file with mixed
# endings that some TSV consumers cannot handle.
*.tsv text eol=lf

# Dockerfiles run in Linux containers -- CRLF breaks shell continuations and heredocs.
Dockerfile text eol=lf

# The recursion-depth oracle fixtures ARE the specification, so their bytes must
# arrive identical on every platform. RFC4180 keeps a line break inside a quoted
# field as part of the VALUE, which `text=auto` cannot tell apart from a record
# terminator: a Windows checkout rewrote one to CRLF and made R05 and R36
# unsatisfiable by any delivery, the reference implementation included. A sweep
# run there would have scored every tree down for a reason that has nothing to
# do with decomposition depth.
evals/recursion_depth/spec/*/oracle/data/** -text

# PowerShell scripts -- Windows expects CRLF.
*.ps1 text eol=crlf

# Web dashboard -- Node, Vitest, MSW, and Caddy all expect LF.
# Without this pin, core.autocrlf=true on Windows produces CRLF in worktrees
# while the index stores LF, creating phantom `git status` diffs in
# generated/checked-in files like web/public/mockServiceWorker.js.
web/** text=auto eol=lf

# Generated artifacts -- mark so GitHub collapses them in diffs and
# omits them from language statistics. The OpenAPI client types are
# regenerated wholesale from the backend schema (never hand-edited),
# so their churn should not dominate review diffs.
web/src/api/types/openapi.gen.ts linguist-generated=true -diff
web/src/api/types/*.gen.ts linguist-generated=true -diff
