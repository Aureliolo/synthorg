          "targets": [
            {
              "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
              "expr": "sum by (outcome) (rate(synthorg_blueprint_instantiations_total[5m]))",
              "legendFormat": "{{outcome}}",
              "refId": "A"
