---
const useCases = [
  {
    title: "Web application",
    description:
      "A frontend, an API layer, and a data model built as independent leaves, then assembled bottom-up.",
    features: [
      "Recursive task decomposition",
      "Isolated build containers",
      "Author barred from reviewing",
    ],
    color: "violet",
  },
  {
    title: "Command-line tool",
    description:
      "Argument parsing, core logic, and output formatting split into parts one agent cannot hold at once.",
    features: [
      "Independently buildable units",
      "Bottom-up assembly",
      "Runs on your hardware",
    ],
    color: "teal",
  },
  {
    title: "API service",
    description:
      "Routes, request validation, and persistence become separate leaves, built together and checked before they merge.",
    features: [
      "Concurrent leaf builds",
      "Reviewer separated from author",
      "Any provider, local included",
    ],
    color: "violet",
  },
  {
    title: "Data pipeline",
    description:
      "Extraction, transformation, and loading split into stages built and checked without waiting on each other.",
    features: [
      "Dependency-aware decomposition",
      "Isolated containers per leaf",
      "Provider-agnostic",
    ],
    color: "teal",
  },
  {
    title: "Browser extension",
    description:
      "Background script, content script, and settings UI as separate leaves rather than one tangle.",
    features: [
      "Parallel leaf builds",
      "Never reviews its own work",
      "Self-hosted: no SynthOrg service in the path",
    ],
    color: "violet",
  },
  {
    title: "Internal tool",
    description:
      "A form, a database schema, and a small dashboard, each checked by something that did not write it.",
    features: [
      "Recursive decomposition",
      "Independent review",
      "Models you choose",
    ],
    color: "teal",
  },
];
---

<div
  class="use-case-scroll flex gap-6 overflow-x-auto snap-x snap-mandatory pb-4 -mx-6 px-6
         lg:grid lg:grid-cols-3 lg:overflow-x-visible lg:snap-none lg:pb-0 lg:mx-0 lg:px-0"
  role="region"
  aria-label="Use case examples"
  tabindex="0"
>
  {useCases.map((uc) => {
    const borderColor = uc.color === "violet" ? "border-violet-500/20 hover:border-violet-500/40" : "border-teal-500/20 hover:border-teal-500/40";
    const titleColor = uc.color === "violet" ? "text-violet-400" : "text-teal-400";
    const dotColor = uc.color === "violet" ? "bg-violet-400" : "bg-teal-400";
    return (
      <div class={`min-w-[300px] flex-shrink-0 snap-center bg-[#0F1219] rounded-xl p-6 border ${borderColor} transition-colors lg:min-w-0 lg:shrink`}>
        <h3 class={`${titleColor} font-semibold mb-2`}>{uc.title}</h3>
        <p class="text-sm text-gray-400 mb-4">{uc.description}</p>
        <ul class="text-xs text-gray-400 space-y-1">
          {uc.features.map((f) => (
            <li class="flex items-center gap-2">
              <span class={`w-1.5 h-1.5 rounded-full ${dotColor} shrink-0`}></span>
              {f}
            </li>
          ))}
        </ul>
      </div>
    );
  })}
</div>

<style>
  /* Scrollbar styling (no plugin needed) */
  .use-case-scroll {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }
  .use-case-scroll::-webkit-scrollbar {
    height: 6px;
  }
  .use-case-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .use-case-scroll::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
  }

  /* Gradient fade hints for scroll on mobile */
  @media (max-width: 1023px) {
    .use-case-scroll {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent,
        black 24px,
        black calc(100% - 24px),
        transparent
      );
      mask-image: linear-gradient(
        to right,
        transparent,
        black 24px,
        black calc(100% - 24px),
        transparent
      );
    }
  }
</style>
