# =============================================================================
# Consolidated .dockerignore -- applies to all Docker builds from repo root
# =============================================================================
# Both backend and web images build with context: . (repo root).
# Backend needs: pyproject.toml, uv.lock, src/
# Web needs: web/
#
# PATTERN SEMANTICS, and the reason most lines below carry `**/`:
# Docker's ignore patterns do not cross `/` on their own, unlike
# .gitignore's. A bare `__pycache__/` matches ONLY the repository root, so
# every nested cache still enters the build context. That is how a
# developer's typeguard-instrumented test bytecode ended up inside the
# backend image alongside the build's own. Anything that must be excluded
# at any depth needs the `**/` prefix; a pattern naming a specific
# top-level directory (`docker/`, `scripts/`, `web/dist/`) does not.

# Git
.git/
# In a git WORKTREE `.git` is a FILE holding a gitdir pointer, which the
# trailing-slash pattern above does not match. The dev arm builds with a
# worktree as its context root, so both forms are needed.
.git
.github/
.gitignore

# Docker configs (Dockerfiles read via -f, not from context)
# Sidecar is un-excluded because its Dockerfile copies Go source from docker/sidecar/.
docker/
!docker/sidecar/
!docker/sandbox/healthz.py
# OpenHands image copies its entrypoint, the metrics reader that entrypoint
# imports, and its hash-pinned lock from the context.
!docker/openhands/run_task.py
!docker/openhands/metrics_shape.py
!docker/openhands/requirements.lock

# Tests
tests/

# Documentation. No image build reads it: the docs site is a host-side
# zensical build whose output melange picks up from _site/, outside any
# Docker context. `*.md` is separately load-bearing -- the backend and
# fine-tune builds deliberately keep README.md out of the context and
# `RUN touch README.md` an empty one, because hatchling requires the file
# to exist but nothing needs its contents.
docs/
*.md

# Documentation build output (Zensical)
_site/

# Astro landing page (not needed by any Docker build)
site/

# Benchmark harness and generated project data (host-side tooling only)
evals/
data/

# Virtual environments
**/.venv/
**/venv/

# Python caches
**/__pycache__/
**/*.py[cod]
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/

# Hypothesis test database
**/.hypothesis/

# Coverage
**/htmlcov/
**/coverage.xml
**/.coverage
**/.coverage.*

# Databases, including SQLite's write-ahead log and shared-memory siblings
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3

# Environment files. A local .env holds provider API keys, MASTER_KEY and
# POSTGRES_PASSWORD; the whole context is uploaded to the daemon, so these
# must be excluded at every depth rather than only at the root.
**/.env
**/.env.*

# IDE
**/.idea/
**/.vscode/

# CI/build utility scripts (not needed in Docker builds).
# embed_logfire_token.py is allowlisted because the backend Dockerfile
# copies and runs it, rewriting the embedded telemetry token when
# LOGFIRE_PROJECT_TOKEN is supplied as a --build-arg.
scripts/
!scripts/embed_logfire_token.py

# CLI (Go binary, not needed in Docker builds)
cli/

# Agent tooling config
.claude/
.opencode/

# Logs
**/logs/
**/*.log

# OS files
**/Thumbs.db
**/.DS_Store

# Web dashboard build artifacts and test infrastructure
**/node_modules/
web/dist/
web/__tests__/
web/vitest.config.*

# uv
.python-version
