          "description": "synthorg_audit_chain_appends_total partitioned by status (signed / fallback / error). Sustained 'error' rate indicates a TSA / signing infrastructure outage.",
          "targets": [
            {
              "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
              "expr": "sum by (status) (rate(synthorg_audit_chain_appends_total[5m]))",
