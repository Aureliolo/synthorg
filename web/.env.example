VITE_API_BASE_URL=

# Dev-only: skip the login screen (set to "true" to enable).
# Auto-logs-in as the EXISTING admin via the gated, password-free
# `POST /auth/dev-login`. The session is a real JWT cookie and the backend
# still enforces auth on every request, so this needs a running backend that
# itself has SYNTHORG_DEV_AUTH_BYPASS set, and an admin account that already
# exists (one is never fabricated). It does NOT bypass the setup flow: setup
# status is read from the backend, so the first-run wizard stays reachable.
# Only works when running `npm run dev` (import.meta.env.DEV must be true).
# VITE_DEV_AUTH_BYPASS=true
