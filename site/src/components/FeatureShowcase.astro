---
const heroFeatures = [
  {
    icon: "\u2699",
    title: "Orchestration Engine",
    headline: "A build split into a tree, driven by one engine.",
    description:
      "Recursive decomposition into independently buildable units, four model-routing strategies, and crash recovery. Tested end to end; live acceptance in development.",
    differentiator:
      "Sequential, parallel, Kanban, and Agile sprint workflows in the design.",
    href: "/docs/design/engine/",
    color: "violet",
  },
  {
    icon: "\uD83D\uDD12",
    title: "Governance & Security",
    headline: "Every action classified, audited, and gated, by design.",
    description:
      "A fail-closed rule engine with an LLM evaluator for the uncertain cases, four operator-set oversight modes, and budget enforcement. Wired and driven live; no run has reached a completed build.",
    differentiator:
      "Autonomy is not trust: privileges are never auto-granted, and widening is a human act.",
    href: "/docs/security/",
    color: "teal",
  },
  {
    icon: "\uD83E\uDDE0",
    title: "Agent Identity",
    headline: "Agents designed with a role, an authority, and a review.",
    description:
      "A bound (role, model) pair per agent, authority derived from the role's place in the reporting graph, quality scoring, and hiring through offboarding with memory archival. Modelled and tested as components.",
    differentiator:
      "Not interchangeable workers; the reviewer cannot be the agent that wrote the work.",
    href: "/docs/design/agents/",
    color: "violet",
  },
  {
    icon: "\uD83D\uDDC3",
    title: "Memory & Knowledge",
    headline: "Multiple memory types. Knowledge designed to outlast any agent.",
    description:
      "Working, episodic, semantic, procedural, and social memory with hybrid prompt and retrieval injection, built to survive offboarding and transfer to successors. Wired and durable; memory stays off until you choose an embedding model.",
    differentiator:
      "Organisational knowledge designed to persist across the agent lifecycle.",
    href: "/docs/design/memory/",
    color: "teal",
  },
];

---

<!-- Hero feature cards -->
<div class="grid md:grid-cols-2 gap-6">
  {heroFeatures.map((f) => {
    const borderColor = f.color === "violet"
      ? "border-violet-500/20 hover:border-violet-500/40"
      : "border-teal-500/20 hover:border-teal-500/40";
    const iconBg = f.color === "violet" ? "bg-violet-600/20" : "bg-teal-600/20";
    const iconColor = f.color === "violet" ? "text-violet-400" : "text-teal-400";
    const diffColor = f.color === "violet" ? "text-violet-400/80" : "text-teal-400/80";
    const ringColor = f.color === "violet" ? "focus-visible:ring-violet-400" : "focus-visible:ring-teal-400";
    return (
      <a
        href={f.href}
        class={`block bg-[#0F1219] rounded-xl p-8 border ${borderColor} transition-colors no-underline text-white group focus-visible:outline-none focus-visible:ring-2 ${ringColor} focus-visible:ring-offset-2 focus-visible:ring-offset-[#0F1219]`}
      >
        <div class={`w-12 h-12 rounded-lg ${iconBg} flex items-center justify-center ${iconColor} mb-4 text-xl`}>
          {f.icon}
        </div>
        <h3 class="text-xl font-semibold mb-1">{f.title}</h3>
        <p class={`text-sm ${iconColor} font-medium mb-3`}>{f.headline}</p>
        <p class="text-gray-400 text-sm mb-3">{f.description}</p>
        <p class={`text-xs ${diffColor} italic`}>{f.differentiator}</p>
      </a>
    );
  })}
</div>
