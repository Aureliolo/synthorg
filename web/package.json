{
  "name": "synthorg-dashboard",
  "private": true,
  "version": "0.9.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ test-infra/ --max-warnings 0",
    "type-check": "tsc -b",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "bench": "vitest bench --run --project=bench",
    "analyze": "cross-env VITE_ANALYZE=true vite build",
    "size": "size-limit",
    "e2e": "playwright test e2e/flows",
    "lighthouse": "lhci autorun",
    "lint:knip": "knip --no-progress",
    "lint:circular": "dpdm --no-warning --no-tree --exit-code circular:1 src/main.tsx",
    "report:deps": "madge --exclude \"^(node_modules|dist)/\" src/main.tsx",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "generate:api-types": "uv run python ../scripts/generate_dto_types_ts.py",
    "check:api-types": "uv run python ../scripts/check_dto_types_ts_in_sync.py",
    "postinstall": "node -e \"try{require.resolve('msw/package.json')}catch{process.exit(0)}\" && msw init public --no-save"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@dagrejs/dagre": "3.1.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@lezer/highlight": "1.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@xyflow/react": "12.11.2",
    "axios": "1.19.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk-base": "1.0.0",
    "d3-force": "3.0.0",
    "html-to-image": "1.11.13",
    "js-yaml": "5.2.3",
    "lucide-react": "1.30.0",
    "motion": "13.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router": "8.3.0",
    "recharts": "3.10.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "5.7.1",
    "@eslint-react/eslint-plugin": "5.18.3",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@size-limit/file": "13.0.3",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/react": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/d3-force": "3.0.10",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "cross-env": "10.1.0",
    "dpdm": "4.3.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-security": "4.0.1",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "knip": "6.32.0",
    "madge": "8.0.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "openapi-typescript": "7.13.0",
    "rollup-plugin-visualizer": "7.0.1",
    "size-limit": "13.0.3",
    "storybook": "10.5.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "tmp": "0.2.7",
    "esbuild": "0.28.1",
    "uuid": "14.0.1",
    "undici": "7.29.0",
    "brace-expansion": "5.0.9",
    "@lhci/utils": {
      "js-yaml": "4.3.0"
    },
    "@redocly/openapi-core": {
      "js-yaml": "4.3.0"
    }
  }
}
