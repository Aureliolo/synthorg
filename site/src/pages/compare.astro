---
import fs from "node:fs";
import path from "node:path";
import * as yaml from "js-yaml";

import Base from "../layouts/Base.astro";
import ComparisonHero from "../components/ComparisonHero.astro";
import ComparisonFAQ from "../components/ComparisonFAQ.astro";
import ComparisonTable from "../components/islands/ComparisonTable";
import type { Dimension, Category, Competitor } from "../components/islands/ComparisonTable";

// Resolve from the Astro project root (process.cwd()). The build always runs
// with cwd=site/ (workflows pin working-directory: site), so ../data is the
// repo-root data/ folder. import.meta.url is NOT usable here: Astro bundles
// this frontmatter into dist/.prerender chunks, so at build time it points at
// the emitted chunk, not this source file.
const dataPath = path.resolve("../data/competitors.yaml");
let raw: string;
try {
  raw = fs.readFileSync(dataPath, "utf-8");
} catch (err) {
  throw new Error(
    `compare.astro: could not read the comparison data at ${dataPath} ` +
      `(cwd=${process.cwd()}). The Astro build must run from the site/ directory ` +
      `so the repo-root data/ folder resolves. Original error: ${(err as Error).message}`,
  );
}
const data = yaml.load(raw) as {
  dimensions: Dimension[];
  categories: Category[];
  competitors: Competitor[];
};

const missing = ["dimensions", "categories", "competitors"].filter((k) => !data?.[k]);
if (missing.length > 0) {
  throw new Error(`Invalid structure in ${dataPath}: missing required keys: ${missing.join(", ")}`);
}

// The dimension set is owned by the data file and changes there. The page
// renders whatever it is handed, so the only thing worth refusing is an empty
// or non-list value, which would otherwise render a table with no columns and
// no error. An empty array passes the truthiness check above.
const emptyLists = ["dimensions", "categories", "competitors"].filter((k) => {
  const value = data?.[k];
  return !Array.isArray(value) || value.length === 0;
});
if (emptyLists.length > 0) {
  throw new Error(
    `Invalid structure in ${dataPath}: expected a non-empty list for: ${emptyLists.join(", ")}`,
  );
}

const { dimensions, categories, competitors } = data;
// Exclude SynthOrg itself from the "N+ frameworks compared" count
const competitorCount = competitors.filter((c) => !c.is_synthorg).length;

const title = `SynthOrg vs ${competitorCount}+ Agent Frameworks | Feature Comparison`;
const description = `Interactive comparison of SynthOrg against ${competitorCount}+ agent orchestration frameworks, platforms, and research projects. Self-hosted, operator-chosen models, and a reviewer that did not write the work.`;

const siteUrl = Astro.site;
const pageUrl = new URL("/compare/", Astro.site).href;
---

<Base title={title} description={description}>
  <ComparisonHero competitorCount={competitorCount} />

  <!-- ============================================================ -->
  <!-- INTERACTIVE COMPARISON TABLE (React Island) -->
  <!-- ============================================================ -->
  <section class="py-12 px-6" id="comparison-table">
    <div class="max-w-7xl mx-auto">
      <ComparisonTable
        client:load
        competitors={competitors}
        dimensions={dimensions}
        categories={categories}
      />
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- FEATURE DEEP-DIVES -->
  <!-- ============================================================ -->
  <section class="py-16 px-6">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold mb-12 text-center">
        Where SynthOrg is
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-teal-400">
          uniquely different
        </span>
      </h2>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Deep-dive 1: Decomposition -->
        <div class="border border-teal-500/20 rounded-xl p-6 bg-teal-950/10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-teal-600/20 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-teal-400"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
            </div>
            <h3 class="text-xl font-semibold">Split into a tree, not held in one loop</h3>
          </div>
          <p class="text-gray-400 leading-relaxed">
            A single agent holds one thing at a time, so that shape degrades as an
            application grows. Here a build is split into a tree of independently
            buildable units, the leaves built concurrently in isolated containers and
            assembled bottom-up. Making the parts genuinely independent is the hard
            problem, and the one the system is built around.
          </p>
        </div>

        <!-- Deep-dive 2: Independent review -->
        <div class="border border-violet-500/20 rounded-xl p-6 bg-violet-950/10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-violet-600/20 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-violet-400"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3 class="text-xl font-semibold">The reviewer did not write the work</h3>
          </div>
          <p class="text-gray-400 leading-relaxed">
            A finished unit is judged by a different agent, chosen per review with the
            author excluded from the pool. The exclusion is structural, not a convention:
            the service layer removes the author, and a database constraint refuses any
            verdict whose executor and reviewer match. An independent judge is a triage
            filter, not a correctness guarantee.
          </p>
        </div>

        <!-- Deep-dive 3: Self-hosting -->
        <div class="border border-teal-500/20 rounded-xl p-6 bg-teal-950/10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-teal-600/20 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-teal-400"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <h3 class="text-xl font-semibold">It runs on your hardware</h3>
          </div>
          <p class="text-gray-400 leading-relaxed">
            Containers you start, a database you hold, credentials you register. No
            SynthOrg service sits in the path and no provider is privileged: every dispatch
            names a provider and model you chose, including models you run yourself. Spend
            lands on your own accounts rather than a metered platform bill.
          </p>
        </div>

        <!-- Deep-dive 4: Supervision -->
        <div class="border border-violet-500/20 rounded-xl p-6 bg-violet-950/10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-violet-600/20 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-violet-400"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="text-xl font-semibold">Supervision is a property, not a stage</h3>
          </div>
          <p class="text-gray-400 leading-relaxed">
            Actions route through an approval gate under an oversight mode you set (full,
            semi, supervised, locked), with an audit trail behind it and a Docker sandbox
            around tool execution. Autonomy is never granted by an agent to itself:
            widening it is a human act, and a failed check keeps the action gated.
          </p>
        </div>
      </div>
    </div>
  </section>

  <ComparisonFAQ />

  <!-- ============================================================ -->
  <!-- FINAL CTA -->
  <!-- ============================================================ -->
  <section class="py-16 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        Run it on
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-teal-400">
          your own hardware
        </span>
      </h2>
      <p class="text-gray-400 mb-8">
        Stand up the stack locally, register the providers you want, and drive the loop under
        an oversight mode you set. Pre-alpha, built in the open.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/get/" class="px-8 py-3 bg-violet-600 hover:bg-violet-500 rounded-lg font-semibold transition-colors">
          Get Started
        </a>
        <a href="/" class="px-8 py-3 border border-white/20 hover:bg-white/5 rounded-lg font-semibold transition-colors">
          Back to SynthOrg
        </a>
        <a href="https://github.com/Aureliolo/synthorg" class="px-8 py-3 border border-teal-400/50 text-teal-400 hover:bg-teal-400/10 rounded-lg font-semibold transition-colors">
          View on GitHub
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": pageUrl,
    "mainEntity": {
      "@type": "SoftwareApplication",
      "name": "SynthOrg",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Cross-platform",
      "url": siteUrl,
    },
  }).replace(/</g, "\\u003c")} />
</Base>
