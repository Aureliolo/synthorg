[codespell]
# Codespell configuration: project-wide spelling gate.
# Skip generated, vendored, and binary content. Patterns are fnmatch on the
# real filename, so we use ``*package-lock.json`` (path-separator agnostic)
# to match the lock files on both POSIX and Windows. ``.codespellrc`` is
# self-skipped so this file's own directives are never scanned as content.
# The Vale directories are listed twice (`*/.vale/...` and `.vale/...`):
# pre-commit invokes codespell with paths that include a `./` (or
# Windows `.\`) prefix, which the bare `.vale/...` pattern does not
# match. Keep both forms.
skip = .venv,.git,.mypy_cache,.ruff_cache,.pytest_cache,.cache,.claude,node_modules,build,dist,htmlcov,coverage,.coverage,logs,*.log,*.log.*,*.lock,*.png,*.svg,*.jpg,*.jpeg,*.ico,*.gif,*.webp,*.pdf,*.bin,*_pb2.py,*.gen.*,*.min.js,_vendor,web/dist,web/build,playwright-report,test-results,storybook-static,site,_site,_audit,*.svg.gz,scripts/_codespell_baseline.txt,*package-lock.json,uv.lock,.codespellrc,.test_durations.*,*/.vale/styles/Google/*,*/.vale/styles/config/vocabularies/British/*,.vale/styles/Google/*,.vale/styles/config/vocabularies/British/*
# Project vocabulary lives in .vale/styles/config/vocabularies/SynthOrg/accept.txt (one term per line).
# Vale (when wired) consumes the same file; sharing it keeps the two spellers in lock-step.
ignore-words = .vale/styles/config/vocabularies/SynthOrg/accept.txt
# URL citations (e.g. an external blog slug ``...doesnt-work.html``) should not pollute the identifier vocab.
uri-ignore-words-list = doesnt
quiet-level = 3
check-hidden = false
