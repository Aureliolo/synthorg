[codespell]
# Codespell configuration: project-wide spelling gate.
# Skip generated, vendored, and binary content. Patterns are fnmatch on the
# real filename, so we use ``*package-lock.json`` and ``*go.sum``
# (path-separator agnostic) to match the lock and module-hash files in every
# module directory on both POSIX and Windows. ``go.sum`` is skipped because
# its base64 module hashes contain arbitrary letter runs the speller reads as
# prose (a hash ending ``+tE=`` is reported as "the"/"be"/"we"/"to"), and the
# offending fragment changes on every dependency refresh, so a word-level
# ignore entry could never hold. ``.codespellrc`` is self-skipped so this
# file's own directives are never scanned as content.
# The Vale directories are listed twice (`*/.vale/...` and `.vale/...`):
# pre-commit invokes codespell with paths that include a `./` (or
# Windows `.\`) prefix, which the bare `.vale/...` pattern does not
# match. Keep both forms.
skip = .venv,.git,.mypy_cache,.ruff_cache,.pytest_cache,.cache,.claude,node_modules,build,dist,htmlcov,coverage,.coverage,logs,*.log,*.log.*,*.lock,*.png,*.svg,*.jpg,*.jpeg,*.ico,*.gif,*.webp,*.pdf,*.bin,*_pb2.py,*.gen.*,*.min.js,*mockServiceWorker.js,_vendor,web/dist,web/build,playwright-report,test-results,storybook-static,site,_site,_audit,*.svg.gz,scripts/_codespell_baseline.txt,*package-lock.json,uv.lock,*go.sum,.codespellrc,.test_durations.*,*/.vale/styles/Google/*,*/.vale/styles/config/vocabularies/British/*,.vale/styles/Google/*,.vale/styles/config/vocabularies/British/*
# Project vocabulary lives in .vale/styles/config/vocabularies/SynthOrg/accept.txt (one term per line).
# Vale (when wired) consumes the same file; sharing it keeps the two spellers in lock-step.
ignore-words = .vale/styles/config/vocabularies/SynthOrg/accept.txt
# URL citations (e.g. an external blog slug ``...doesnt-work.html``) should not pollute the identifier vocab.
uri-ignore-words-list = doesnt
# Intentional string fragments in gateway streaming tests: a ``"hel"`` + ``"lo"``
# content-delta pair reassembles to "hello", so ``hel`` is deliberate, not a typo.
# Kept here (codespell-only) rather than the shared Vale vocab so Vale is unaffected.
ignore-words-list = hel
# Two literals that are deliberate where they appear and typos everywhere else,
# so each is scoped to the exact spelling rather than added to
# ignore-words-list, which would suppress it repo-wide to satisfy one site.
# ``/FO`` is the Windows ``tasklist`` output-format flag, which codespell reads
# as a misspelling of "of". ``scirpt: check_manual.py`` is the mistyped YAML
# entry a gate test feeds its allowlist to prove a malformed key is reported
# rather than silently dropped; spelling it correctly would test nothing.
# Anchored to the fixture's exact line, trailing ``\n`` included, so neither
# prose containing the word nor a differently-valued YAML entry is covered.
ignore-regex = /FO\b|  - scirpt: check_manual\.py\\n
quiet-level = 3
check-hidden = false
