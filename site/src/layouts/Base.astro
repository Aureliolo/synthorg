---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  enableRecaptcha?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = "Autonomous product studio: a self-hostable platform for synthetic organisations of role-based AI agents. Platform shipped; agent runtime in active development.",
  image = "/og-image.png",
  type = "website",
  enableRecaptcha = false,
  noindex = false,
} = Astro.props;

const ogImageUrl = new URL(image, Astro.site);
// Canonical strips the query string / hash so crawlers collapse URL variants
// onto a single canonical address.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// Sourced from env (see ContactForm.astro). Empty when unset, which suppresses
// the loader + preconnect below so no broken reCAPTCHA call is made.
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ?? "";

// Site-wide Organization structured data (built in frontmatter so the Astro
// global is never referenced inside the inline JSON-LD script).
const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "SynthOrg",
  url: Astro.site,
  logo: new URL("/favicon.svg", Astro.site).href,
  sameAs: ["https://github.com/Aureliolo/synthorg"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {enableRecaptcha && recaptchaSiteKey && (
      <>
        <link rel="preconnect" href="https://www.google.com" />
        <link rel="preconnect" href="https://www.gstatic.com" crossorigin />
      </>
    )}
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="SynthOrg" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {/* Self-hosted fonts via Astro Fonts API (eliminates CLS + Google Fonts
        network dependency). Preload the three above-the-fold families; Geist
        Mono is island-only (ComparisonTable / DashboardPreview), so it is
        emitted without a preload hint. */}
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <Font cssVariable="--font-geist-mono" />
    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify(organizationLd).replace(/</g, "\\u003c")} />
  </head>
  <body class="bg-[#0F1219] text-white font-sans antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:rounded-lg focus:bg-violet-600 focus:text-white focus:font-semibold"
    >
      Skip to main content
    </a>
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    {/* Lazy-load reCAPTCHA v3 when the contact form scrolls into view, with an
        IntersectionObserver + focus fallback. Driven by astro:page-load so it
        re-arms after a ClientRouter (View Transitions) navigation; guards keep
        it idempotent across swaps. */}
    {enableRecaptcha && recaptchaSiteKey && (
      <script define:vars={{ recaptchaSiteKey }}>
        (function () {
          if (window.__recaptchaWired) return;
          window.__recaptchaWired = true;

          // Persist across astro:page-load calls so a revisit to a contact-form
          // page cannot append the reCAPTCHA <script> a second time.
          var loading = false;

          function init() {
            var form = document.getElementById("contact-form");
            if (!form || form.dataset.recaptchaInit) return;
            form.dataset.recaptchaInit = "1";

            function loadRecaptcha() {
              if (
                loading ||
                window.grecaptcha ||
                document.querySelector('script[src^="https://www.google.com/recaptcha/api.js"]')
              ) return;
              loading = true;
              var s = document.createElement("script");
              s.src =
                "https://www.google.com/recaptcha/api.js?render=" +
                recaptchaSiteKey;
              s.async = true;
              s.onerror = function () {
                // Remove the failed element so the existing-script guard above
                // does not block a later retry.
                loading = false;
                s.remove();
                console.warn("reCAPTCHA script failed to load");
              };
              document.head.appendChild(s);
            }

            if ("IntersectionObserver" in window) {
              var observer = new IntersectionObserver(
                function (entries) {
                  if (entries[0].isIntersecting) {
                    loadRecaptcha();
                    observer.disconnect();
                  }
                },
                { rootMargin: "200px" },
              );
              observer.observe(form);
            } else {
              loadRecaptcha();
            }

            form.addEventListener("focusin", function () { loadRecaptcha(); }, { once: true });
          }

          document.addEventListener("astro:page-load", init);
        })();
      </script>
    )}
  </body>
</html>
