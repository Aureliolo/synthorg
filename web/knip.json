{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "src/App.tsx",
    "src/mocks/browser.ts",
    "src/test-setup.tsx",
    "src/**/*.stories.{ts,tsx}",
    "src/**/*.{test,spec,bench}.{ts,tsx}",
    "test-infra/**/*.ts",
    "playwright.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "test-infra/**/*.{ts,tsx}"
  ],
  "ignore": [
    "**/*.gen.ts",
    "**/node_modules/**",
    "dist/**",
    "build-artefacts/**"
  ],
  "ignoreDependencies": [
    "cross-env",
    "@storybook/.*",
    "@types/.*",
    "msw-storybook-addon"
  ]
}
