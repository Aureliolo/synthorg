---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import UseCaseCards from "../components/UseCaseCards.astro";
import FeatureShowcase from "../components/FeatureShowcase.astro";
import ExpandableArchitecture from "../components/ExpandableArchitecture.astro";
import ParticleNetwork from "../components/ParticleNetwork.astro";
import ScrollSyncPanel from "../components/ScrollSyncPanel.astro";
import DashboardPreview from "../components/islands/DashboardPreview";
import GitHubButton from "../components/GitHubButton.astro";

const description = "Where one agent stops, an organisation starts. SynthOrg is a synthetic one: it staffs the roles, splits the work into jobs that stand alone, builds them in parallel, each in its own isolated workspace, and sends each one to a reviewer who had no hand in it. Self-hosted, on your hardware, against models you choose. Pre-alpha.";

const siteUrl = Astro.site;

// Build-time GitHub stats so the Star/Fork buttons show a live-ish count
// without shipping the third-party buttons.github.io script + iframe. Best
// effort: an API failure (rate limit, offline) degrades to a count-less button.
let githubStars: number | null = null;
let githubForks: number | null = null;
try {
  const res = await fetch("https://api.github.com/repos/Aureliolo/synthorg", {
    headers: {
      Accept: "application/vnd.github+json",
      "User-Agent": "SynthOrg-Marketing-Site/1.0",
    },
    signal: AbortSignal.timeout(5000),
  });
  if (res.ok) {
    const data = await res.json();
    githubStars = typeof data.stargazers_count === "number" ? data.stargazers_count : null;
    githubForks = typeof data.forks_count === "number" ? data.forks_count : null;
  }
} catch {
  // Intentionally swallowed: the count is decorative, not load-bearing.
}
---

<Base title="SynthOrg | Self-Hosted AI Software Organisation" description={description} enableRecaptcha={true}>
  <!-- ============================================================ -->
  <!-- HERO (Dark) -->
  <!-- ============================================================ -->
  <section class="relative min-h-[85vh] flex items-center justify-center px-6">
    <ParticleNetwork />

    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <!-- Eyebrow -->
      <p class="text-sm tracking-widest text-violet-400 mb-6 font-mono">
        Pre-alpha &middot; Self-hosted &middot; BUSL 1.1 &middot; Source Available
      </p>

      <!-- Headline -->
      <h1 class="text-5xl md:text-7xl font-bold leading-tight mb-6">
        Where one agent stops,
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-teal-400">
          an organisation starts
        </span>
      </h1>

      <!-- Subtext -->
      <p class="text-lg md:text-xl text-gray-400 max-w-2xl mx-auto mb-10">
        SynthOrg is a synthetic one: it staffs the roles, splits the work into
        jobs that stand alone, and sends each one to a reviewer who had no hand
        in it
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="/get/"
          class="px-8 py-3 bg-violet-600 hover:bg-violet-500 rounded-lg font-semibold transition-colors"
        >
          Start Building
        </a>
        <a
          href="#license-usage"
          class="px-8 py-3 border border-teal-400/50 text-teal-400 hover:bg-teal-400/10 rounded-lg font-semibold transition-colors"
        >
          License & Usage Restrictions
        </a>
        <GitHubButton
          href="https://github.com/Aureliolo/synthorg"
          label="Star"
          ariaLabel="Star Aureliolo/synthorg on GitHub"
          variant="star"
          count={githubStars}
        />
      </div>

      <!-- Scroll hint -->
      <a href="#how-it-works" class="mt-12 inline-block text-gray-400 hover:text-gray-300 animate-bounce motion-reduce:animate-none" aria-label="Scroll down for more details">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </a>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- EARLY-ACCESS DISCLAIMER -->
  <!-- ============================================================ -->
  <section class="py-4 px-6 bg-gradient-to-r from-violet-600/10 via-teal-600/10 to-violet-600/10 border-y border-violet-500/20">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sm text-gray-300">
        Pre-alpha software, not yet fully working.
        <a href="/docs/roadmap/" class="text-teal-400 underline decoration-teal-400/40 hover:decoration-teal-400">Roadmap</a> ·
        <a href="https://github.com/Aureliolo/synthorg/issues" class="text-teal-400 underline decoration-teal-400/40 hover:decoration-teal-400">Issue tracker</a> ·
        <a href="#contact" class="text-teal-400 underline decoration-teal-400/40 hover:decoration-teal-400">Get in touch</a>
      </p>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- PROOF STRIP -->
  <!-- ============================================================ -->
  <section class="py-8 border-y border-white/10">
    <div class="max-w-5xl mx-auto flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm text-gray-400">
      <span class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-violet-400"></span> Type-Safe
      </span>
      <span class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-teal-400"></span> Async-First
      </span>
      <span class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-violet-400"></span> Protocol-Driven
      </span>
      <span class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-teal-400"></span> Provider-Agnostic
      </span>
      <span class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-violet-400"></span> Runs Local Models
      </span>
      <span class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-teal-400"></span> Self-Hosted
      </span>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- HOW IT WORKS -- Scroll-Synced Split Panel -->
  <!-- ============================================================ -->
  <ScrollSyncPanel />

  <!-- ============================================================ -->
  <!-- FEATURE SHOWCASE (transition to lighter) -->
  <!-- ============================================================ -->
  <section class="py-16 px-6 bg-gradient-to-b from-[#0F1219] to-[#1a1f2e]">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">What Makes SynthOrg Different</h2>
      <p class="text-gray-400 text-center max-w-2xl mx-auto mb-12">
        The binding constraint is decomposition quality, not agent supply. The design puts its weight there: splitting work into genuinely independent parts, building them separately, and checking each against something that did not write it.
      </p>
      <FeatureShowcase />
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- EXPANDABLE ARCHITECTURE -->
  <!-- ============================================================ -->
  <section class="py-16 px-6">
    <div class="max-w-5xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Architecture</h2>
      <p class="text-gray-400 mb-12">The modular, protocol-driven architecture. Every component is pluggable and built as tested code.</p>

      <ExpandableArchitecture />

      <a href="/docs/architecture/" class="inline-block mt-8 text-teal-400 underline decoration-teal-400/40 hover:decoration-teal-400 transition-colors">
        Explore full architecture &rarr;
      </a>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- SECURITY -->
  <!-- ============================================================ -->
  <section class="py-16 px-6 bg-gradient-to-b from-[#0F1219] to-[#1a1025]">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">Security-First by Design</h2>
      <p class="text-gray-400 text-center max-w-2xl mx-auto mb-16">
        Agents that run tools need guardrails. The pipeline and container
        hardening below ships today, and the runtime guardrails gate every
        action.
      </p>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Runtime Security -->
        <a href="/docs/security/#application-security" class="block bg-[#0F1219] rounded-xl p-8 border border-teal-500/20 hover:border-teal-500/40 transition-colors no-underline text-white">
          <div class="w-12 h-12 rounded-lg bg-teal-600/20 flex items-center justify-center text-teal-400 mb-4 text-xl">&#128737;</div>
          <h3 class="text-xl font-semibold mb-3">Runtime Protection</h3>
          <p class="text-gray-400 mb-4">Hybrid SecOps: a fail-closed rule-engine fast-path with an LLM evaluator for uncertain cases, classified action types, and four operator-set oversight modes (full, semi, supervised, locked).</p>
          <ul class="text-sm text-gray-400 space-y-1">
            <li>Fail-closed rule engine + LLM fallback evaluator</li>
            <li>Four oversight modes, widened only by a human</li>
            <li>Output scanning with redaction policies</li>
            <li>Persistent audit trail for every decision</li>
          </ul>
        </a>

        <!-- Container & Supply Chain -->
        <a href="/docs/security/#container-hardening" class="block bg-[#0F1219] rounded-xl p-8 border border-teal-500/20 hover:border-teal-500/40 transition-colors no-underline text-white">
          <div class="w-12 h-12 rounded-lg bg-teal-600/20 flex items-center justify-center text-teal-400 mb-4 text-xl">&#128230;</div>
          <h3 class="text-xl font-semibold mb-3">Hardened Infrastructure</h3>
          <p class="text-gray-400 mb-4">Distroless containers, digest-pinned images, and CIS Docker Benchmark compliance. Every image is vulnerability-scanned and signed before push.</p>
          <ul class="text-sm text-gray-400 space-y-1">
            <li>Wolfi apko-composed distroless runtime (no shell)</li>
            <li>Trivy vulnerability scanning</li>
            <li>cosign keyless image signing</li>
            <li>CIS 5.3 / 5.12 / 5.25 compliance</li>
          </ul>
        </a>

        <!-- CI/CD Security -->
        <a href="/docs/security/#cicd-security" class="block bg-[#0F1219] rounded-xl p-8 border border-teal-500/20 hover:border-teal-500/40 transition-colors no-underline text-white">
          <div class="w-12 h-12 rounded-lg bg-teal-600/20 flex items-center justify-center text-teal-400 mb-4 text-xl">&#9889;</div>
          <h3 class="text-xl font-semibold mb-3">Continuous Security</h3>
          <p class="text-gray-400 mb-4">Eight security scanners run across the full development lifecycle, from first commit to production deployment. Secret detection, SAST, DAST, dependency auditing, license compliance, and supply chain scoring.</p>
          <ul class="text-sm text-gray-400 space-y-1">
            <li>gitleaks, CodeQL, ZAP DAST, zizmor</li>
            <li>pip-audit + npm audit + Socket.dev</li>
            <li>OSSF Scorecard supply chain maturity</li>
            <li>Signed commits + required reviews</li>
          </ul>
        </a>
      </div>

      <div class="text-center mt-10">
        <a href="/docs/security/" class="text-teal-400 underline decoration-teal-400/40 hover:decoration-teal-400 transition-colors">
          Read the full security documentation &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- USE CASES -->
  <!-- ============================================================ -->
  <section class="py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">Use Cases</h2>
      <p class="text-gray-400 text-center max-w-2xl mx-auto mb-16">
        These describe the shape of work the system is designed for.
      </p>

      <UseCaseCards />
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- DASHBOARD PREVIEW -->
  <!-- ============================================================ -->
  <section class="py-16 px-6 bg-gradient-to-b from-[#0F1219] to-[#1a1025]">
    <div class="max-w-5xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">See the Dashboard</h2>
      <p class="text-gray-400 mb-12 max-w-2xl mx-auto">
        The React 19 dashboard for work, agents, approvals, and spend, with live WebSocket updates. It shows what is running, what is waiting on you, and what it costs.
      </p>
      <DashboardPreview client:visible />
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- COMPARISON CTA -->
  <!-- ============================================================ -->
  <section class="py-12 px-6">
    <div class="max-w-4xl mx-auto">
      <a href="/compare/" class="block rounded-xl border border-violet-500/30 bg-gradient-to-r from-violet-950/30 via-[#0F1219] to-teal-950/30 p-8 md:p-10 hover:border-violet-500/50 transition-colors no-underline text-white group">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <h2 class="text-2xl md:text-3xl font-bold mb-2">
              How does SynthOrg
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-teal-400">compare?</span>
            </h2>
            <p class="text-gray-400 max-w-xl">
              See a side-by-side comparison against CrewAI, AutoGen, LangGraph, ChatDev, and more,
              from how work is decomposed to how it is checked and where it runs.
            </p>
          </div>
          <span class="shrink-0 px-6 py-3 rounded-lg bg-violet-600 group-hover:bg-violet-500 font-semibold transition-colors">
            Compare Projects
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- LICENSE & USAGE -->
  <!-- ============================================================ -->
  <section id="license-usage" class="py-16 px-6 bg-gradient-to-b from-[#1a1f2e] to-[#0F1219]">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">License & Usage</h2>
      <p class="text-gray-400 text-center max-w-2xl mx-auto mb-16">
        SynthOrg uses the <a href="https://github.com/Aureliolo/synthorg/blob/main/LICENSE" class="text-teal-400 underline decoration-teal-400/40 hover:decoration-teal-400">Business Source License 1.1</a>:
        source available, production-friendly for most users, converting to Apache 2.0 automatically.
      </p>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Always Free -->
        <div class="bg-[#0F1219] rounded-xl p-8 border border-green-500/20">
          <div class="w-12 h-12 rounded-lg bg-green-600/20 flex items-center justify-center text-green-400 mb-4 text-xl">&#10003;</div>
          <h3 class="text-xl font-semibold mb-3 text-green-400">Always Free</h3>
          <ul class="text-gray-400 space-y-2 text-sm">
            <li>Personal learning and experimentation</li>
            <li>Academic and research use</li>
            <li>Development, testing, and evaluation</li>
            <li>Contributing to SynthOrg itself</li>
          </ul>
        </div>

        <!-- Free in Production -->
        <div class="bg-[#0F1219] rounded-xl p-8 border border-teal-500/20">
          <div class="w-12 h-12 rounded-lg bg-teal-600/20 flex items-center justify-center text-teal-400 mb-4 text-xl">&#10003;</div>
          <h3 class="text-xl font-semibold mb-3 text-teal-400">Free in Production</h3>
          <ul class="text-gray-400 space-y-2 text-sm">
            <li>Organizations with &lt;500 employees and contractors (including affiliates)</li>
            <li>Non-competing use: internal tools, automation, or products where SynthOrg is not the core value</li>
            <li>No separate license needed; see <a href="https://github.com/Aureliolo/synthorg/blob/main/LICENSE" class="text-teal-400 underline decoration-teal-400/40 hover:decoration-teal-400">LICENSE</a> for full terms</li>
          </ul>
        </div>

        <!-- Commercial License -->
        <div class="bg-[#0F1219] rounded-xl p-8 border border-violet-500/20">
          <div class="w-12 h-12 rounded-lg bg-violet-600/20 flex items-center justify-center text-violet-400 mb-4 text-xl">&#9993;</div>
          <h3 class="text-xl font-semibold mb-3 text-violet-400">Commercial License</h3>
          <ul class="text-gray-400 space-y-2 text-sm">
            <li>Organizations with 500+ employees</li>
            <li>Offering SynthOrg as a hosted service</li>
            <li>Reselling or embedding as core product</li>
            <li>May be granted at no cost; just ask</li>
          </ul>
        </div>
      </div>

      <div class="text-center mt-10">
        <p class="text-gray-400 text-sm mb-4">
          Every version converts to Apache 2.0 automatically. We welcome feedback on the license:
          <a href="https://github.com/Aureliolo/synthorg/discussions" class="text-teal-400 underline decoration-teal-400/40 hover:decoration-teal-400">start a discussion</a> or
          <a href="https://github.com/Aureliolo/synthorg/issues" class="text-teal-400 underline decoration-teal-400/40 hover:decoration-teal-400">open an issue</a>.
        </p>
        <a href="/docs/licensing/" class="text-teal-400 underline decoration-teal-400/40 hover:decoration-teal-400 transition-colors">
          Read the full licensing rationale &rarr;
        </a>

        <div class="flex flex-col sm:flex-row gap-4 items-center justify-center mt-8">
          <div class="flex gap-3">
            <GitHubButton
              href="https://github.com/Aureliolo/synthorg"
              label="Star"
              ariaLabel="Star Aureliolo/synthorg on GitHub"
              variant="star"
              count={githubStars}
            />
            <GitHubButton
              href="https://github.com/Aureliolo/synthorg/fork"
              label="Fork"
              ariaLabel="Fork Aureliolo/synthorg on GitHub"
              variant="fork"
              count={githubForks}
            />
          </div>
          <a
            href="/docs/"
            class="px-8 py-3 border border-white/20 hover:bg-white/5 rounded-lg font-semibold transition-colors"
          >
            Read the Documentation
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- FINAL CTA -->
  <!-- ============================================================ -->
  <section class="py-16 px-6 bg-gradient-to-b from-[#0F1219] to-[#1a1025]">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-5xl font-bold mb-6">
        Keep the build
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-teal-400">on your own machine.</span>
      </h2>

      <a
        href="/get/"
        class="inline-block px-10 py-4 bg-violet-600 hover:bg-violet-500 rounded-lg font-semibold text-lg transition-colors"
      >
        Get Started
      </a>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- CONTACT -->
  <!-- ============================================================ -->
  <section id="contact" class="py-16 px-6">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">Get in Touch</h2>
      <p class="text-gray-400 text-center max-w-xl mx-auto mb-10">
        Questions about licensing, commercial use, or the framework? We'd love to hear from you.
      </p>
      <ContactForm />
    </div>
  </section>

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "SynthOrg",
    "description": description,
    "url": siteUrl,
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Linux, macOS, Windows",
    "license": "https://github.com/Aureliolo/synthorg/blob/main/LICENSE",
    "author": {
      "@type": "Person",
      "name": "Aurelio",
      "url": "https://github.com/Aureliolo",
    },
  }).replace(/</g, "\\u003c")} />
</Base>
