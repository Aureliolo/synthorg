"""Domain errors for the {{.ModuleDocSlug}} subsystem.

Every class here reaches ``DomainError``: ``{{.ClassName}}Error`` and
``{{.ClassName}}NotFoundError`` inherit from generics in
``synthorg.core.domain_errors``, and ``{{.ClassName}}AlreadyRunningError``
from the subsystem base above it. All three therefore reuse the existing
``EXCEPTION_HANDLERS`` mappings without registering a new ``ErrorCode`` enum
value. When the subsystem grows distinct client-facing semantics (e.g. a 422
unique to this domain), promote the class to its own ``error_code`` -- see
``docs/reference/errors.md`` for the registration recipe.
"""

from typing import ClassVar

from synthorg.core.domain_errors import DomainError, NotFoundError


class {{.ClassName}}Error(DomainError):
    """Base class for {{.ModuleDocSlug}} subsystem failures."""

    default_message: ClassVar[str] = "{{.ClassName}} subsystem error"


class {{.ClassName}}NotFoundError(NotFoundError):
    """Raised when a {{.ModuleDocSlug}} entity is not found."""

    default_message: ClassVar[str] = "{{.ClassName}} not found"


class {{.ClassName}}AlreadyRunningError({{.ClassName}}Error):
    """Raised when :meth:`start` is called on a service already running.

    An inheritance alias of the subsystem base: it carries no distinct
    client-facing semantics, so it reuses that class's ``error_code`` and
    exists to name the condition at the raise site.
    """

    default_message: ClassVar[str] = "{{.ClassName}} service is already running"
