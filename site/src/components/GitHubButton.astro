---
// Self-contained GitHub Star/Fork link, built in-house rather than embedding
// GitHub's buttons.github.io script + iframe, which loads on every page and
// leaks visitor IPs to GitHub. The optional count is fetched at build time by
// the caller and passed in; a null count renders a count-less button.
interface Props {
  href: string;
  label: string;
  ariaLabel: string;
  variant?: "star" | "fork";
  count?: number | null;
}

const { href, label, ariaLabel, variant = "star", count = null } = Astro.props;

const ICONS = {
  star: "M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z",
  fork: "M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z",
};

const formatCount = (n: number): string =>
  n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, "")}k` : String(n);
---

<a
  href={href}
  rel="noopener noreferrer"
  aria-label={ariaLabel}
  class="inline-flex items-center gap-2 px-4 py-2 bg-white/5 hover:bg-white/10 border border-white/15 rounded-lg text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-500"
>
  <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
    <path d={ICONS[variant]} />
  </svg>
  <span>{label}</span>
  {
    count !== null && (
      <span class="px-2 py-0.5 rounded-md bg-white/10 text-gray-300 tabular-nums">
        {formatCount(count)}
      </span>
    )
  }
</a>
