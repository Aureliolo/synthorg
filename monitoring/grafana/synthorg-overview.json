          "description": "synthorg_settings_mutations_total. Namespace label mirrors filenames in src/synthorg/settings/definitions/. Spikes correlate with operator-driven configuration changes.",
          "targets": [
            {
              "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
              "expr": "sum by (namespace) (rate(synthorg_settings_mutations_total[5m]))",
              "legendFormat": "{{namespace}}",
              "refId": "A"
