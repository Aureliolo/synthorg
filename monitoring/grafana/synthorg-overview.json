          "description": "synthorg_approval_decisions_total partitioned by outcome (approved / rejected / expired). Counter is incremented from api/controllers/approvals.py and api/approval_store.py.",
          "targets": [
            {
              "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
              "expr": "sum by (outcome) (rate(synthorg_approval_decisions_total[5m]))",
