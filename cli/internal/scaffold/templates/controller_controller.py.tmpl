"""{{title .ModuleDocSlug}} controller -- list / get / delete endpoints."""

from typing import Any

from litestar import Controller, Request, Response, delete, get
from litestar.datastructures import State
from litestar.status_codes import HTTP_204_NO_CONTENT

from synthorg.api.dto import ApiResponse, PaginatedResponse, PaginationMeta
from synthorg.api.guards import require_read_access, require_write_access
from synthorg.api.path_params import PathId
from synthorg.api.responses import require_resource_or_404
from synthorg.api.services.{{.Domain}}_service import {{.ClassName}}Service
from synthorg.core.domain_errors import NotFoundError
from synthorg.observability import get_logger
from synthorg.observability.events.api import API_RESOURCE_NOT_FOUND
from synthorg.{{.Domain}}.models import {{.ClassName}}Item

logger = get_logger(__name__)


def _service(state: State) -> {{.ClassName}}Service:
    """Build the per-request :class:`{{.ClassName}}Service` instance."""
    return {{.ClassName}}Service(repo=state.app_state.persistence.{{.Domain}}_items)


class {{.ClassName}}Controller(Controller):
    """Controller for {{.ModuleDocSlug}} item listing, retrieval, and deletion."""

    path = "/{{.Domain}}"
    tags = ("{{.Domain}}",)

    @get(guards=[require_read_access])
    async def list_{{.Domain}}_items(
        self,
        state: State,
        limit: int = 50,
        offset: int = 0,
    ) -> PaginatedResponse[{{.ClassName}}Item]:
        """List {{.ModuleDocSlug}} items.

        Args:
            state: Application state.
            limit: Page size.
            offset: Pagination offset.

        Returns:
            Paginated list of items.
        """
        items = tuple(await _service(state).list_items(limit=limit, offset=offset))
        # Placeholder pagination: ``PaginationMeta`` is cursor-based, but
        # the scaffold's ``list_items`` returns only the bare item tuple
        # with no cursor metadata. ``has_more=False`` keeps the contract
        # internally consistent (a cursorless page cannot honestly
        # advertise a next page); the accompanying ``<domain>_WIRING.md``
        # walks through promoting this to real cursor pagination once
        # the service exposes the backend's cursor metadata.
        return PaginatedResponse[{{.ClassName}}Item](
            data=items,
            pagination=PaginationMeta(
                limit=limit,
                next_cursor=None,
                has_more=False,
            ),
        )

    @get("/{item_id:str}", guards=[require_read_access])
    async def get_{{.Domain}}_item(
        self,
        state: State,
        item_id: PathId,
    ) -> Response[ApiResponse[{{.ClassName}}Item]]:
        """Get a {{.ModuleDocSlug}} item by ID.

        Args:
            state: Application state.
            item_id: {{.ClassName}} identifier.

        Returns:
            The item, or 404 if not found.
        """
        item = require_resource_or_404(
            await _service(state).get(item_id),
            resource_type="{{.ClassName}}",
            identifier=item_id,
            log_event=API_RESOURCE_NOT_FOUND,
            operation="read",
        )
        return Response(content=ApiResponse[{{.ClassName}}Item](data=item), status_code=200)

    @delete(
        "/{item_id:str}",
        guards=[require_write_access],
        status_code=HTTP_204_NO_CONTENT,
    )
    async def delete_{{.Domain}}_item(
        self,
        request: Request[Any, Any, Any],  # noqa: ARG002
        state: State,
        item_id: PathId,
    ) -> None:
        """Delete a {{.ModuleDocSlug}} item by ID.

        Raises:
            NotFoundError: Item with ``item_id`` does not exist.
        """
        service = _service(state)
        deleted = await service.delete(item_id)
        if not deleted:
            logger.warning(
                API_RESOURCE_NOT_FOUND,
                resource="{{.Domain}}",
                item_id=item_id,
                operation="delete",
            )
            msg = f"{{.ClassName}} {item_id!r} not found"
            raise NotFoundError(msg)
